rules_version = '2';

// Each signed-in user can read and write ONLY their own data under
// /users/{their uid}/... Nobody else (and nobody signed out) can see it.
//
// Writes are also checked: only the app's collections, the right field types
// and sane sizes. Extra fields are allowed (backups from the old offline
// version carry a few more), so this never blocks the app's normal writes.
//
// After changing this file: Firebase Console → Firestore → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ---- field helpers (d = the document as it will be after the write)
    function str(d, f, maxLen) {
      return f in d && d[f] is string && d[f].size() <= maxLen;
    }
    function optStr(d, f, maxLen) {
      return !(f in d) || d[f] == null || (d[f] is string && d[f].size() <= maxLen);
    }
    function num(d, f) {
      return f in d && d[f] is int;
    }
    function optNum(d, f) {
      return !(f in d) || d[f] == null || d[f] is int;
    }
    function base(d, docId) {
      return d.size() <= 40
          && str(d, 'id', 100) && d.id == docId
          && num(d, 'created_at') && optNum(d, 'updated_at') && optNum(d, 'deleted_at');
    }

    function validCategoryOrProject(d, docId) {
      return base(d, docId) && str(d, 'name', 200) && num(d, 'color');
    }
    function validMember(d, docId) {
      return base(d, docId) && str(d, 'name', 200);
    }
    function validTask(d, docId) {
      return base(d, docId)
          && str(d, 'title', 500)
          && optStr(d, 'description', 20000)
          && optStr(d, 'category_id', 100)
          && optStr(d, 'project_id', 100)
          && optStr(d, 'assignee_id', 100)
          && num(d, 'priority')
          && d.status in ['pending', 'completed', 'cancelled']
          && num(d, 'start_at') && optNum(d, 'end_at') && optNum(d, 'completed_at')
          && (!('stage' in d) || d.stage in ['todo', 'doing', 'review'])
          && (!('repeat' in d) || validRepeat(d.repeat))
          && optStr(d, 'repeat_from', 100)
          && optStr(d, 'completed_by', 100)
          && (!('checklist' in d) || d.checklist == null
              || (d.checklist is list && d.checklist.size() <= 200))
          && optList(d, 'links', 20)
          && optList(d, 'history', 150)
          && optList(d, 'time_log', 1000)
          && optStr(d, 'timer_by', 100) && optNum(d, 'timer_at') && optNum(d, 'move_to')
          && (!('estimate_min' in d) || d.estimate_min == null
              || (d.estimate_min is int && d.estimate_min > 0 && d.estimate_min <= 1440));
    }
    // none, daily, weekdays, weekly, biweekly, monthly, month_end, yearly, or
    // chosen weekdays "days:1,4" (1 = Monday).
    function validRepeat(r) {
      return r is string && (r in ['none', 'daily', 'weekdays', 'weekly', 'biweekly', 'monthly',
          'month_end', 'yearly'] || r.matches('days:[1-7](,[1-7]){0,6}'));
    }
    function optList(d, f, maxLen) {
      return !(f in d) || d[f] == null || (d[f] is list && d[f].size() <= maxLen);
    }
    function validTemplate(d, docId) {
      return d.size() <= 15
          && str(d, 'id', 100) && d.id == docId
          && str(d, 'name', 100) && str(d, 'title', 500)
          && optStr(d, 'description', 20000)
          && num(d, 'priority')
          && (!('checklist' in d) || (d.checklist is list && d.checklist.size() <= 200))
          && num(d, 'created_at')
          && optStr(d, 'category', 40) && optNum(d, 'color') && optStr(d, 'icon', 40)
          && optList(d, 'tasks', 60) && optStr(d, 'created_by', 100);
    }
    function validNotification(d, docId) {
      return base(d, docId)
          && d.type in ['task', 'system']
          && str(d, 'kind', 50) && str(d, 'title', 300) && str(d, 'body', 2000)
          && optStr(d, 'task_id', 100) && optNum(d, 'read_at')
          && optStr(d, 'team_id', 100) && optStr(d, 'actor_name', 200)
          && optNum(d, 'snooze_until');
    }
    // Inbox: quick captures waiting to be organized.
    function validInbox(d, docId) {
      return d.size() <= 25
          && str(d, 'id', 100) && d.id == docId
          && str(d, 'title', 500) && d.title.size() > 0
          && optStr(d, 'notes', 5000)
          && d.source in ['quick', 'email', 'voice', 'forwarded']
          && num(d, 'created_at') && optNum(d, 'due_at')
          && (!('all_day' in d) || d.all_day is bool)
          && optNum(d, 'priority')
          && optStr(d, 'team_id', 100) && optStr(d, 'assignee_id', 100)
          && optStr(d, 'category_id', 100)
          && optList(d, 'links', 20)
          && optStr(d, 'from_id', 100) && optStr(d, 'from_name', 200)
          && optNum(d, 'organized_at') && optStr(d, 'organized_to', 300)
          && optStr(d, 'task_id', 100) && optStr(d, 'task_team', 100);
    }
    function validProfile(d) {
      return d.size() <= 20 && optStr(d, 'name', 200) && optStr(d, 'email', 320)
          && optNum(d, 'created_at')
          && optStr(d, 'title', 100)
          && optNum(d, 'reminder_minutes')
          && (!('team_alerts' in d) || d.team_alerts is bool)
          && optList(d, 'saved_views', 20)
          && (!('notif_assign' in d) || d.notif_assign is bool)
          && (!('notif_approvals' in d) || d.notif_approvals is bool)
          && (!('notif_comments' in d) || d.notif_comments is bool)
          && optNum(d, 'last_backup_at')
          && optNum(d, 'work_start') && optNum(d, 'work_end')
          && (!('work_days' in d) || (d.work_days is list && d.work_days.size() <= 7));
    }

    function valid(collection, d, docId) {
      return (collection == 'tasks' && validTask(d, docId))
          || ((collection == 'categories' || collection == 'projects')
              && validCategoryOrProject(d, docId))
          || (collection == 'members' && validMember(d, docId))
          || (collection == 'notifications' && validNotification(d, docId))
          || (collection == 'inbox' && validInbox(d, docId))
          || (collection == 'templates' && validTemplate(d, docId));
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validProfile(request.resource.data);

      match /{collection}/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && valid(collection, request.resource.data, docId);
      }

      // A teammate may forward an item into my inbox: as themselves, through
      // a team we are both in. They cannot read, change or delete it.
      match /inbox/{docId} {
        allow create: if request.auth != null && request.auth.uid != userId
            && validInbox(request.resource.data, docId)
            && request.resource.data.source == 'forwarded'
            && request.resource.data.from_id == request.auth.uid
            && request.resource.data.team_id is string
            && request.auth.uid in get(/databases/$(database)/documents/teams/$(request.resource.data.team_id)).data.member_ids
            && userId in get(/databases/$(database)/documents/teams/$(request.resource.data.team_id)).data.member_ids
            && !('organized_at' in request.resource.data && request.resource.data.organized_at != null);
      }
    }

    // ================================================================ TEAMS
    //
    // teams/{teamId}: owner_id, member_ids (everyone, owner included),
    // manager_ids (managers, owner not included), members {uid: {name, email}}.
    //   Owner   : rename, change managers, remove people, delete the team
    //   Manager : invite people, remove plain members, create/edit/assign tasks
    //   Member  : see the team, mark own tasks done, leave the team
    // Nobody is added directly: people join by accepting an invite sent to
    // their (verified) email address.

    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function teamData(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }
    function isTeamAdmin(tm) {
      return request.auth.uid == tm.owner_id || request.auth.uid in tm.manager_ids;
    }

    function validTeam(d, teamId) {
      return d.size() <= 20
          && str(d, 'id', 100) && d.id == teamId
          && str(d, 'name', 100) && d.name.size() > 0
          && num(d, 'color')
          && d.owner_id is string
          && d.member_ids is list && d.member_ids.size() <= 200
          && d.owner_id in d.member_ids
          && d.manager_ids is list
          && d.member_ids.toSet().hasAll(d.manager_ids)
          && !(d.owner_id in d.manager_ids)
          && d.members is map
          && d.members.keys().toSet() == d.member_ids.toSet()
          && num(d, 'created_at') && optNum(d, 'updated_at')
          && (!('week_hours' in d) || (d.week_hours is int && d.week_hours > 0
              && d.week_hours <= 100));
    }
    function validMemberInfo(info) {
      return info is map
          && info.keys().hasOnly(['name', 'email', 'week_min', 'day_min', 'work_days', 'busy'])
          && info.name is string && info.name.size() <= 200
          && info.email is string && info.email.size() <= 320
          && (!('week_min' in info) || (info.week_min is int
              && info.week_min > 0 && info.week_min <= 10080))
          && (!('day_min' in info) || (info.day_min is int
              && info.day_min > 0 && info.day_min <= 1440))
          && (!('work_days' in info) || (info.work_days is list && info.work_days.size() <= 7))
          // Busy minutes per day for the next 14 days (totals only).
          && (!('busy' in info) || (info.busy is map && info.busy.size() <= 15));
    }

    match /teams/{teamId} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function changed() { return after().diff(before()).affectedKeys(); }
      function added() { return after().member_ids.toSet().difference(before().member_ids.toSet()); }
      function removed() { return before().member_ids.toSet().difference(after().member_ids.toSet()); }
      function infoChanged() { return after().members.diff(before().members).affectedKeys(); }
      function me() { return request.auth.uid; }

      // Owner: anything except adding people or changing the owner.
      function ownerEdit() {
        return me() == before().owner_id && added().size() == 0;
      }
      // Manager: may only remove plain members (not the owner or managers).
      function managerRemoves() {
        return me() in before().manager_ids
            && changed().hasOnly(['member_ids', 'members', 'updated_at'])
            && added().size() == 0 && removed().size() > 0
            && removed().intersection(before().manager_ids.toSet().union([before().owner_id].toSet())).size() == 0
            && infoChanged() == removed();
      }
      // Accepting an invite: add yourself, nothing else.
      function joinByInvite() {
        return !(me() in before().member_ids)
            && changed().hasOnly(['member_ids', 'members', 'updated_at'])
            && added() == [me()].toSet() && removed().size() == 0
            && infoChanged() == [me()].toSet()
            && validMemberInfo(after().members[me()])
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/invites/$(teamId + '_' + myEmail()));
      }
      // Leaving: remove yourself (the owner cannot leave, only delete).
      function leave() {
        return me() in before().member_ids && me() != before().owner_id
            && changed().hasOnly(['member_ids', 'members', 'manager_ids', 'updated_at'])
            && removed() == [me()].toSet() && added().size() == 0
            && infoChanged() == [me()].toSet()
            && after().manager_ids.toSet() == before().manager_ids.toSet().difference([me()].toSet());
      }
      // Updating your own name/email in the team.
      function selfInfo() {
        return me() in before().member_ids
            && changed().hasOnly(['members', 'updated_at'])
            && infoChanged() == [me()].toSet()
            && validMemberInfo(after().members[me()]);
      }

      allow read: if signedIn() && request.auth.uid in resource.data.member_ids;
      allow create: if signedIn()
          && validTeam(request.resource.data, teamId)
          && request.resource.data.owner_id == request.auth.uid
          && request.resource.data.member_ids == [request.auth.uid]
          && request.resource.data.manager_ids.size() == 0
          && validMemberInfo(request.resource.data.members[request.auth.uid]);
      allow update: if signedIn()
          && validTeam(request.resource.data, teamId)
          && after().owner_id == before().owner_id
          && after().created_at == before().created_at
          && (ownerEdit() || managerRemoves() || joinByInvite() || leave() || selfInfo());
      allow delete: if signedIn() && request.auth.uid == resource.data.owner_id;

      match /tasks/{taskId} {
        function assigneeOk(d, tm) {
          return !('assignee_id' in d) || d.assignee_id == null || d.assignee_id in tm.member_ids;
        }
        // A member may only move their own task on the board (stage), tick
        // its checklist, use the work timer and attach links to the work (the
        // history and time log are added to along the way). Marking it done
        // is for owner/managers, or the member on a task they made themselves.
        function assigneeUpdate(tm) {
          return request.auth.uid in tm.member_ids
              && resource.data.assignee_id == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'completed_at', 'completed_by', 'checklist', 'stage',
                      'history', 'time_log', 'timer_by', 'timer_at', 'links', 'move_to',
                      'updated_at'])
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['timer_by'])
                  || request.resource.data.timer_by == null
                  || request.resource.data.timer_by == request.auth.uid)
              && (!('completed_by' in request.resource.data)
                  || request.resource.data.completed_by == null
                  || request.resource.data.completed_by == request.auth.uid)
              && request.resource.data.status in ['pending', 'completed']
              // Done / not done only on a task they made for themselves; a
              // task from a manager goes to Review and the manager finishes it.
              && (request.resource.data.status == resource.data.status
                  || resource.data.created_by == request.auth.uid)
              && validTask(request.resource.data, taskId);
        }

        allow read: if signedIn() && request.auth.uid in teamData(teamId).member_ids;
        // Finishing a repeating task creates its next copy; the assignee may
        // do that for their own task (same title, person and repeat).
        function repeatCopy(tm) {
          let d = request.resource.data;
          let src = get(/databases/$(database)/documents/teams/$(teamId)/tasks/$(d.repeat_from)).data;
          return request.auth.uid in tm.member_ids
              && src.assignee_id == request.auth.uid
              && validRepeat(src.repeat) && src.repeat != 'none'
              && d.repeat == src.repeat
              && d.title == src.title
              && d.assignee_id == src.assignee_id
              && d.created_by == src.created_by
              && d.status == 'pending';
        }

        // Any member may keep their own tasks in the team: created by them and
        // assigned to them (they can edit and delete those).
        function ownTask(d) {
          return d.created_by == request.auth.uid && d.assignee_id == request.auth.uid;
        }

        allow create: if signedIn()
            && validTask(request.resource.data, taskId)
            && assigneeOk(request.resource.data, teamData(teamId))
            && ((isTeamAdmin(teamData(teamId))
                    && request.resource.data.created_by == request.auth.uid)
                || (request.auth.uid in teamData(teamId).member_ids
                    && ownTask(request.resource.data))
                || ('repeat_from' in request.resource.data
                    && request.resource.data.repeat_from is string
                    && repeatCopy(teamData(teamId))));
        allow update: if signedIn() && (
            (isTeamAdmin(teamData(teamId))
                && validTask(request.resource.data, taskId)
                && assigneeOk(request.resource.data, teamData(teamId)))
            || assigneeUpdate(teamData(teamId))
            || (request.auth.uid in teamData(teamId).member_ids
                && ownTask(resource.data) && ownTask(request.resource.data)
                && request.resource.data.created_by == resource.data.created_by
                && validTask(request.resource.data, taskId)));
        allow delete: if signedIn() && (isTeamAdmin(teamData(teamId))
            || (request.auth.uid in teamData(teamId).member_ids && ownTask(resource.data)));
      }

      // Templates shared with the team: members use them, owner/managers
      // create, change and delete them.
      match /templates/{templateId} {
        allow read: if signedIn() && request.auth.uid in teamData(teamId).member_ids;
        allow create, update: if signedIn() && isTeamAdmin(teamData(teamId))
            && validTemplate(request.resource.data, templateId);
        allow delete: if signedIn() && isTeamAdmin(teamData(teamId));
      }

      // Comments on the team's tasks: any member can write (as themselves);
      // the author or an owner/manager can delete. Comments cannot be edited.
      match /comments/{commentId} {
        function validComment(d) {
          return d.size() <= 10
              && str(d, 'id', 100) && d.id == commentId
              && str(d, 'task_id', 100)
              && d.author_id == request.auth.uid
              && optStr(d, 'author_name', 200)
              && str(d, 'text', 2000) && d.text.size() > 0
              && num(d, 'created_at')
              && (!('mentions' in d) || (d.mentions is list && d.mentions.size() <= 50))
              && exists(/databases/$(database)/documents/teams/$(teamId)/tasks/$(d.task_id));
        }

        allow read: if signedIn() && request.auth.uid in teamData(teamId).member_ids;
        allow create: if signedIn()
            && request.auth.uid in teamData(teamId).member_ids
            && validComment(request.resource.data);
        allow delete: if signedIn()
            && (resource.data.author_id == request.auth.uid || isTeamAdmin(teamData(teamId)));
      }
    }

    // ============================================================= MESSAGES
    //
    // chats/{id}: direct chats between two people who share a team (id
    // "<uidA>_<uidB>"), chat requests to someone outside my teams (id
    // "req_<uid>_<email>", accepted by that email) and one chat per team
    // (id "team_<teamId>"). Only the people in a chat can read or write it.
    function teamChatMember(teamId) {
      return request.auth.uid in teamData(teamId).member_ids;
    }
    function inChat(c) {
      return request.auth.uid in c.member_ids
          || (c.type == 'team' && teamChatMember(c.team_id));
    }

    match /chats/{chatId} {
      function d() { return request.resource.data; }
      function validChat() {
        return d().size() <= 15
            && d().id == chatId
            && d().type in ['direct', 'team']
            && d().member_ids is list && d().member_ids.size() <= 2
            && d().created_by == request.auth.uid
            && num(d(), 'created_at')
            && (!('names' in d()) || d().names is map);
      }
      // A teammate asks to chat: starts pending, the other person approves.
      function teammates() {
        return d().type == 'direct' && d().status == 'pending'
            && !('blocked_by' in d()) && !('invite_email' in d())
            && d().member_ids.size() == 2 && request.auth.uid in d().member_ids
            && chatId == d().member_ids[0] + '_' + d().member_ids[1]
            && d().via_team is string
            && d().member_ids[0] in teamData(d().via_team).member_ids
            && d().member_ids[1] in teamData(d().via_team).member_ids;
      }
      function chatRequest() {
        return d().type == 'direct' && d().status == 'pending'
            && d().member_ids == [request.auth.uid]
            && d().invite_email is string && d().invite_email == d().invite_email.lower()
            && d().invite_email != myEmail()
            && chatId == 'req_' + request.auth.uid + '_' + d().invite_email;
      }
      function teamChat() {
        return d().type == 'team' && d().team_id is string
            && chatId == 'team_' + d().team_id
            && d().member_ids.size() == 0
            && teamChatMember(d().team_id);
      }
      function changed() { return d().diff(resource.data).affectedKeys(); }

      allow get: if signedIn() && (
          (resource == null && chatId.matches('team_.+')
              && teamChatMember(chatId.replace('^team_', '')))
          || (resource != null && (inChat(resource.data)
              || resource.data.get('invite_email', '') == myEmail())));
      allow list: if signedIn() && (request.auth.uid in resource.data.member_ids
          || resource.data.invite_email == myEmail());
      allow create: if signedIn() && validChat() && (teammates() || chatRequest() || teamChat());
      allow update: if signedIn() && (
          // New message / read: the list fields only (only "read" once blocked).
          (inChat(resource.data)
              && changed().hasOnly(['last_text', 'last_at', 'last_from', 'read'])
              && (resource.data.get('status', 'active') != 'blocked' || changed().hasOnly(['read']))
              && optStr(d(), 'last_text', 300) && optNum(d(), 'last_at')
              && (!('last_from' in d()) || d().last_from == null
                  || d().last_from == request.auth.uid
                  || !changed().hasAny(['last_from']))
              && (!('read' in d()) || d().read is map))
          // A teammate's request to me: approve or block it.
          || (resource.data.type == 'direct' && resource.data.status == 'pending'
              && !('invite_email' in resource.data)
              && request.auth.uid in resource.data.member_ids
              && resource.data.created_by != request.auth.uid
              && changed().hasOnly(['status', 'read', 'blocked_by'])
              && ((d().status == 'active' && !('blocked_by' in d()))
                  || (d().status == 'blocked' && d().blocked_by == request.auth.uid)))
          // Block the other person in a direct chat.
          || (resource.data.type == 'direct' && resource.data.get('status', 'active') == 'active'
              && !('invite_email' in resource.data)
              && request.auth.uid in resource.data.member_ids
              && changed().hasOnly(['status', 'blocked_by'])
              && d().status == 'blocked' && d().blocked_by == request.auth.uid)
          // Only the one who blocked can unblock.
          || (resource.data.status == 'blocked'
              && resource.data.blocked_by == request.auth.uid
              && changed().hasOnly(['status', 'blocked_by'])
              && d().status == 'active' && d().blocked_by == null)
          // Accepting a chat request: add yourself.
          || (resource.data.status == 'pending'
              && resource.data.invite_email == myEmail()
              && request.auth.token.email_verified == true
              && changed().hasOnly(['member_ids', 'names', 'status', 'read'])
              && d().status == 'active'
              && d().member_ids.toSet()
                  == resource.data.member_ids.toSet().union([request.auth.uid].toSet())
              && d().member_ids.size() == 2));
      // Not by the blocked person (that would undo the block).
      allow delete: if signedIn() && resource.data.type == 'direct' && (
          (request.auth.uid in resource.data.member_ids
              && (resource.data.get('status', 'active') != 'blocked'
                  || resource.data.blocked_by == request.auth.uid))
          || (resource.data.status == 'pending' && resource.data.invite_email == myEmail()));

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function validMessage(m) {
          return m.size() <= 12
              && m.id == messageId
              && m.from == request.auth.uid
              && optStr(m, 'from_name', 200)
              && str(m, 'text', 4000)
              && num(m, 'at')
              && optList(m, 'links', 10)
              && optStr(m, 'task_id', 100) && optStr(m, 'task_team', 100)
              && optStr(m, 'task_title', 500);
        }
        allow read: if signedIn() && inChat(chat());
        // Accepted chats and team chats; a pending one only by the person
        // asking; nothing once blocked.
        allow create: if signedIn() && inChat(chat()) && validMessage(request.resource.data)
            && (chat().get('status', 'active') == 'active'
                || (chat().status == 'pending' && chat().created_by == request.auth.uid));
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    // invites/{teamId}_{email}: readable by the invited email and the team's
    // owner/managers. Accepting = joining the team + deleting the invite.
    match /invites/{inviteId} {
      function validInvite(d) {
        return d.size() <= 10
            && str(d, 'id', 500) && d.id == inviteId
            && str(d, 'team_id', 100) && str(d, 'team_name', 100)
            && str(d, 'email', 320) && d.email == d.email.lower() && d.email.matches('[^@ ]+@[^@ ]+')
            && inviteId == d.team_id + '_' + d.email
            && d.invited_by == request.auth.uid
            && optStr(d, 'invited_by_name', 200)
            && num(d, 'created_at');
      }

      allow read: if signedIn()
          && (resource.data.email == myEmail() || isTeamAdmin(teamData(resource.data.team_id)));
      allow create: if signedIn()
          && validInvite(request.resource.data)
          && isTeamAdmin(teamData(request.resource.data.team_id))
          && !(request.resource.data.email == myEmail());
      allow delete: if signedIn()
          && (resource.data.email == myEmail() || isTeamAdmin(teamData(resource.data.team_id)));
    }
  }
}
