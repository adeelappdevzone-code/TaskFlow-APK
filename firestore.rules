rules_version = '2';

// Each signed-in user can read and write ONLY their own data under
// /users/{their uid}/... Nobody else (and nobody signed out) can see it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
